# Copy to .env.local and fill in. Never commit real values.
# Wallet addresses and exchange API keys are NOT configured here: they are added in the
# app (Sources) and stored per user, API keys encrypted with ENCRYPTION_KEY.

# Neon Postgres connection string (use a dev branch locally).
DATABASE_URL=

# Optional minimum log level: debug | info | warn | error
# (default: info in production, debug elsewhere).
LOG_LEVEL=

# Better Auth: session signing secret (>= 32 chars, `openssl rand -base64 32`)
# and the canonical app URL (http://localhost:3002 locally, production URL on Vercel).
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3002

# Google OAuth client (Google Cloud Console → APIs & Services → Credentials).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated emails allowed to sign in, e.g. anna@example.com,bob@example.com
ALLOWED_EMAILS=

# Encrypts exchange API keys (AES-256-GCM): base64 of 32 random bytes, `openssl rand -base64 32`.
# Keep a copy in a password manager: if it is lost or changed, API keys must be entered again.
ENCRYPTION_KEY=

# CoinGecko API key (prices, logos, categories).
COINGECKO_API_KEY=

# From phase 2:
# Authorizes Vercel Cron calls to the scheduled routes (`openssl rand -hex 32`).
# CRON_SECRET=
# Keys of the chosen EVM and Solana data providers are added here once they are chosen.
